# Vorlage. Kopieren nach .env und anpassen. Die Datei .env wird nicht eingecheckt.
# Laden mit:  node --env-file=.env ...  oder die Variablen im Terminal setzen.

# Trace-Export: console (Standard), otlp oder none
TRACE_EXPORTER=console
# Ziel für otlp, z. B. das lokale Jaeger aus docker-compose.yml
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Salt für die pseudonymisierte Fallreferenz. Leer lassen = zufällig pro Lauf.
CASE_REF_SALT=

# Modellanbieter: mock (Standard), ollama, openai-compatible oder foundry
MODEL_PROVIDER=mock

# ollama (lokal, ohne API-Key)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=

# openai-compatible (API-Anbieter)
# MODEL_BASE_URL=
# MODEL_NAME=
# MODEL_API_KEY=

# foundry (Anmeldung über Microsoft Entra ID, z. B. az login. Kein API-Key.)
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL_NAME=
