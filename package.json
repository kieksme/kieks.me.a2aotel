{
  "name": "kieks.me.a2aotel",
  "version": "0.1.0",
  "private": true,
  "description": "Beispielprojekt: OpenTelemetry-Tracing und Agent-to-Agent-Kommunikation (A2A) mit Berechtigungsprüfung",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
